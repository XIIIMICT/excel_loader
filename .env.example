[TEMPLATE]
# excel_loader — единый шаблон конфигурации: cp .env.example .env.

# ── Логирование (Alloy → Loki, контейнер el-alloy) ──
# Адрес Loki, доступный из контейнера Alloy. В standalone-режиме — имя
# сервиса этого же compose-проекта (loki); для внешнего/центрального Loki
# задайте host.docker.internal:3100 или полный адрес сервера.
LOKI_URL=http://loki:3100
# Лейбл env на всех логах (Alloy). local для локальных/standalone запусков;
# на сервере задайте prod, чтобы прод-логи отличались от локальных.
LOG_ENV=local

# ── Метрики запусков (Pushgateway) ──
# Loader — пакетный CLI: он не держит /metrics, а пушит состояние запусков
# (infra/compose.observability.yaml, профиль standalone; см. src/metrics.py).
# Пусто — метрики не пушатся. Prometheus с Pushgateway читает их раз в 15 s.
METRICS_PUSHGATEWAY_URL=http://pushgateway:9091

# ── PostgreSQL ──
# Доступен loader-у по POSTGRES_HOST (переопределяет common.postgres.host
# из config.toml; по умолчанию compose ставит host.docker.internal) и
# учётным данным ниже. Обязательны и для standalone-стека этого проекта.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=strong_password
POSTGRES_DB=dwh

# ── Данные входа в админку Grafana (el-grafana, профиль standalone) ──
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=strong_password

# ── Почта алертов (Alertmanager) ──
# Значения рендерятся при старте контейнера — после правки перезапустите
# стек (`just monitoring`). ВАЖНО: ALERT_SMTP_SMARTHOST — порт с STARTTLS
# (587); порт 465 (неявный TLS) не работает с smtp_require_tls.
# ALERT_SMTP_USER = адрес отправителя (= ALERT_SMTP_FROM).
ALERT_SMTP_SMARTHOST=smtp.mail.ru:587
ALERT_SMTP_FROM=alerts@example.ru
ALERT_SMTP_USER=alerts@example.ru
ALERT_SMTP_PASSWORD=strong_password
SUPPORT_MAIL=datapro@example.ru

# ── Права на bind-папки (Linux) ───────────────
# Контейнер el-loader пишет в ./logs и ./unloaded_data; на Linux bind-папки
# принадлежат пользователю, от которого снят деплой, поэтому loader
# запускается с его UID/GID, чтобы файлы не создавались root'ом. Заполните
# своим id -u / id -g:
#   printf 'HOST_UID=%s\nHOST_GID=%s\n' "$(id -u)" "$(id -g)" >> .env
# В Docker Desktop значения игнорируются; 1000/1000 — безопасный дефолт.
# HOST_UID=1000
# HOST_GID=1000

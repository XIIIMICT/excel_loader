[TEMPLATE]
# Логи loader (Alloy в infra/compose.alloy.yaml) отправляются сюда.
LOKI_URL=http://loki:3100

# Компоненты наблюдательного стека (infra/compose.monitoring.yaml, профиль standalone):
# метрики запусков loader пушатся в Pushgateway, Prometheus собирает их и
# поднимает алерты, Alertmanager доставляет письма. Пусто — метрики не пушатся.
METRICS_PUSHGATEWAY_URL=http://pushgateway:9091

# ---------------------------------------------------------------------
# Переменные ниже становятся обязательными, если вы хотите поднять БД и сервисы
# логирования/мониторинга внутри этого же проекта (по умолчанию они подразумеваются
# как внешние)
# ---------------------------------------------------------------------
# Данные для входа в админ-панель Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=strong_password

# Данные PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=strong_password
POSTGRES_DB=dwh

# ---------------------------------------------------------------------
# Почта алертов (Alertmanager); рендерится при старте контейнера — после
# правки нужен перезапуск стека (`just monitoring`).
# ВАЖНО: ALERT_SMTP_SMARTHOST — порт с STARTTLS (587); 465 (неявный TLS)
# не работает с smtp_require_tls. ALERT_SMTP_USER = адрес отправителя.
# ---------------------------------------------------------------------
ALERT_SMTP_SMARTHOST=smtp.mail.ru:587
ALERT_SMTP_FROM=alerts@example.ru
ALERT_SMTP_USER=alerts@example.ru
ALERT_SMTP_PASSWORD=strong_password
SUPPORT_MAIL=datapro@example.ru

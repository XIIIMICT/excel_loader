local.file_match "excel_loader_logs" {
  path_targets = [
    {
      "__path__" = "/var/log/excel_loader/*.log",
      "app"      = "excel_loader",
      "env"      = sys.env("LOG_ENV"), // LOG_ENV: local|prod — задаётся в compose (из .env)
      "job"      = "excel_loader",
    },
  ]

  sync_period = "5s"
}

loki.source.file "excel_loader_logs" {
  targets       = local.file_match.excel_loader_logs.targets
  forward_to    = [loki.process.excel_loader.receiver]
  tail_from_end = false
}

loki.process "excel_loader" {
  stage.json {
    expressions = {
      "level"  = "level",
      "logger" = "logger",
      "module" = "module",
      "run_id" = "run_id",
      "exception" = "exception",
      "time"   = "timestamp",
    }
  }

  stage.labels {
    values = {
      "level"  = "",
      "logger" = "",
      "module" = "",
    }
  }

  stage.structured_metadata {
    values = {
      // Queryable but NOT labels: run_id is unique per run and exception is
      // a multi-line value — either as a label would explode the Loki index.
      "run_id"    = "run_id",
      "exception" = "exception",
    }
  }

  stage.timestamp {
    source = "time"
    format = "RFC3339Nano"
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = sys.env("LOKI_URL") + "/loki/api/v1/push"
  }
}
